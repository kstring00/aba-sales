# ─── The Support Shelf — environment ─────────────────────────────────────────
# Copy to .env.local for local development. Never commit real values.
# Variables prefixed NEXT_PUBLIC_ are shipped to the browser; everything else
# stays on the server.

# Public site URL (no trailing slash). Used for auth redirects and share links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project URL and anon key are safe in the browser; RLS does the protecting.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Aliases kept for parity with the build spec (server reads either name).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service key bypasses RLS. SERVER ONLY. Used for: Stripe webhook writes,
# account deletion, Pro share-link reads. Never import in client code.
SUPABASE_SERVICE_KEY=

# ── Local RLS tests (tests/rls) ──────────────────────────────────────────────
# A plain Postgres 16 with the auth shim in supabase/local applied.
RLS_TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/support_shelf_test

# ── Stripe (TEST MODE ONLY) ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs for the two TEST products: Pro monthly ($6) and Pro yearly ($49).
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# ── Shopify Storefront API (Phase 2, read-only) ──────────────────────────────
SHOPIFY_STORE_DOMAIN=vgb9f2-eg.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=

# ── Support Guide AI (Phase 1B) ──────────────────────────────────────────────
# Provider is configurable; credentials never reach the client.
AI_PROVIDER=mock
AI_API_KEY=
# Live AI stays off until professional safety and privacy review is complete.
AI_LIVE_ENABLED=false
