# ─── The Support Shelf — environment ─────────────────────────────────────────
# Copy to .env.local for local development. Never commit real values.
# NEXT_PUBLIC_ values are shipped to the browser; everything else is server-only.

# Public site URL (no trailing slash). Used for metadata and emailed links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Shopify Storefront API (read-only + cart mutations; never the Admin API) ──
SHOPIFY_STORE_DOMAIN=vgb9f2-eg.myshopify.com
# Public Storefront access token (Headless channel). Safe to expose; scoped to
# unauthenticated reads and cart mutations only.
SHOPIFY_STOREFRONT_TOKEN=
# Storefront API version.
SHOPIFY_API_VERSION=2025-10

# ── Resend (free tier) — "Email me my export" on /abc ─────────────────────────
RESEND_API_KEY=
# Must be on a domain verified in Resend before it can send to anyone but you.
RESEND_FROM="The Support Shelf <onboarding@resend.dev>"
# Optional: Resend Audience ID to add emails to.
RESEND_AUDIENCE_ID=

# ── Contact details shown in the footer ───────────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com
NEXT_PUBLIC_CONTACT_PHONE=
